{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "curatedbynat",
    "compatibility_date": "2026-09-20",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./src/worker.ts",
    "assets": { "directory": "./dist", "binding": "ASSETS" },
    "observability": { "enabled": true },
    "routes": [
        { "pattern": "curatedbynat.com", "custom_domain": true },
        { "pattern": "www.curatedbynat.com", "custom_domain": true }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "curatedbynat-inquiries",
            "database_id": "43ac1125-a959-4632-95d9-13c291691a3d",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [{ "binding": "INSTAGRAM_BUCKET", "bucket_name": "curatedbynat-instagram" }],
    // Every six hours the Worker copies Nat's newest Instagram posts into the bucket above (a no-op when nothing is new).
    "triggers": { "crons": ["17 */6 * * *"] },
    "ratelimits": [
        { "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
    ],
    "vars": {
        "INQUIRY_TO": "hello@curatedbynat.com",
        "INQUIRY_FROM": "Curated by Nat website <website@curatedbynat.com>"
    }
}
