---
// Instagram (Lucide) and TikTok glyphs from `Site Header.dc.html`. Decorative: the link that
// wraps the icon carries the accessible name.
interface Props {
    name: 'instagram' | 'tiktok';
    size?: number;
    class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {
        name === 'instagram' ? (
            <>
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </>
        ) : (
            <path d="M15 3c.4 2.4 2 4 4.5 4.3v3.1c-1.7 0-3.2-.5-4.5-1.4v6.2a5.2 5.2 0 1 1-5.2-5.2h.6v3.2a2.1 2.1 0 1 0 1.5 2V3z" />
        )
    }
</svg>
