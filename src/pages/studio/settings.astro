---
// Settings. For now: the price lists that bookings are made from. More arrive with later parts of Studio.
import Notice from '../../components/studio/Notice.astro';
import PriceListForm from '../../components/studio/PriceListForm.astro';
import StudioLayout from '../../layouts/StudioLayout.astro';
import { listExtras, listPackages, packageDetails } from '../../lib/studio/bookings';
import { formatCents } from '../../lib/studio/money';
import { listTemplates } from '../../lib/studio/admin';
import { getFeedToken } from '../../lib/studio/calendarDb';
import { firstNameFromEmail } from '../../lib/studio/people';
import { getSettings } from '../../lib/studio/queries';
import { PLACEHOLDERS } from '../../lib/studio/templates';
import { studioDb } from '../../lib/studio/server';

export const prerender = false;

const db = studioDb();
if (!db) return Astro.redirect('/studio?error=database-missing', 303);
const [packages, extras, templates, general] = await Promise.all([
    listPackages(db, { includeInactive: true }),
    listExtras(db, { includeInactive: true }),
    listTemplates(db),
    getSettings(db),
]);
const user = Astro.locals.studioUser;
const feedUrl = `${Astro.url.origin}/cal/${await getFeedToken(db)}.ics`;
const webcalUrl = feedUrl.replace(/^https?:/, 'webcal:');
const kinds = [
    { kind: 'package' as const, title: 'Packages', items: packages, empty: 'No packages yet. Add the first one below.' },
    { kind: 'extra' as const, title: 'Extras', items: extras, empty: 'No extras yet.' },
];
---

<StudioLayout title="Settings" current="settings">
    <p class="st-eyebrow">Studio</p>
    <h1 class="st-title">Settings</h1>
    <Notice />

    <section class="st-card" id="calendar-feed" aria-labelledby="feed-heading">
        <h2 class="st-card__title" id="feed-heading">Calendar on your phone</h2>
        <p>Add this once and your events, consultations and follow-ups show up in your phone's own calendar app. It only goes one way: Studio to your phone.</p>
        <p class="st-callout">The calendar shows first names, what kind of item it is, the time and the city. No phone numbers, emails, notes or money. Anyone with this link can see it, so keep it private.</p>

        <div class="st-field">
            <label class="st-label" for="feed-url">Your private calendar link</label>
            <input class="st-input" id="feed-url" type="text" readonly value={feedUrl} />
        </div>
        <div class="st-actions st-actions--spaced">
            <button class="st-button st-button--secondary st-js-only" type="button" data-copy-from="feed-url" data-copy-status="feed-copy-status">Copy link</button>
            <a class="st-button st-button--primary" href={webcalUrl}>Add to iPhone Calendar</a>
        </div>
        <p class="st-hint" id="feed-copy-status" aria-live="polite"></p>

        <h3 class="st-subtitle">On an iPhone</h3>
        <ol class="st-steps">
            <li>Open Studio on your iPhone and tap <strong>Add to iPhone Calendar</strong> above.</li>
            <li>Tap <strong>Subscribe</strong>, then <strong>Add</strong>.</li>
            <li>New things show up on their own, usually within an hour.</li>
        </ol>
        <p class="st-hint">Or: Settings, Calendar, Accounts, Add Account, Other, Add Subscribed Calendar, then paste the link.</p>

        <h3 class="st-subtitle">In Google Calendar</h3>
        <ol class="st-steps">
            <li>On a computer, open calendar.google.com.</li>
            <li>Next to <strong>Other calendars</strong>, click the plus, then <strong>From URL</strong>.</li>
            <li>Paste your link and click <strong>Add calendar</strong>. Google can take several hours to show changes.</li>
        </ol>

        <details class="st-details st-details--danger">
            <summary class="st-details__summary">Make a new link</summary>
            <form class="st-form" method="post" action="/api/studio/settings/calendar-feed">
                <p>Do this if the link was shared by mistake. The old link stops working straight away, and your phone's calendar will go quiet until you add the new link the same way as above.</p>
                <div class="st-actions">
                    <button class="st-button st-button--danger" type="submit">Make a new link</button>
                </div>
            </form>
        </details>
    </section>

    <section class="st-card" id="general" aria-labelledby="general-heading">
        <h2 class="st-card__title" id="general-heading">Follow-ups and lost leads</h2>
        <form class="st-form" method="post" action="/api/studio/settings/general">
            <div class="st-field">
                <label class="st-label" for="general-days">Flag someone after this many quiet days <span class="st-optional">(1 to 60)</span></label>
                <input class="st-input st-input--small" id="general-days" name="follow_up_days" type="number" inputmode="numeric" min="1" max="60" step="1" required value={general.followUpDays} />
            </div>
            <div class="st-field">
                <label class="st-label" for="general-reasons">Reasons you can pick when a lead is lost <span class="st-optional">(one per line)</span></label>
                <textarea class="st-textarea" id="general-reasons" name="lost_reasons" rows="7" required>{general.lostReasons.join('\n')}</textarea>
            </div>
            <div class="st-actions">
                <button class="st-button st-button--primary" type="submit">Save</button>
            </div>
        </form>
    </section>

    <section class="st-section" id="templates" aria-labelledby="templates-heading">
        <h2 class="st-section-title" id="templates-heading">Reply templates</h2>
        <p class="st-hint">Saved messages that fill in a client's details. Studio doesn't send them: they open in your own email app, or you copy them. The starter ones are drafts. Read them over and make them sound like you.</p>
        <details class="st-details">
            <summary class="st-details__summary">Blanks you can use</summary>
            <dl class="st-dl">
                {PLACEHOLDERS.map((blank) => (
                    <div class="st-dl__row">
                        <dt>{`{${blank.name}}`}</dt>
                        <dd>{blank.meaning}</dd>
                    </div>
                ))}
            </dl>
        </details>
        {templates.map((template) => (
            <div class="st-price-item">
                <details class="st-details">
                    <summary class="st-details__summary">
                        <span class="st-price-item__head">
                            <span>{template.name}</span>
                            {template.is_draft === 1 && <span class="st-pill">Draft</span>}
                        </span>
                    </summary>
                    <form class="st-form" method="post" action={`/api/studio/templates/${template.id}`}>
                        <div class="st-field">
                            <label class="st-label" for={`t-${template.id.slice(-4)}-name`}>Name</label>
                            <input class="st-input" id={`t-${template.id.slice(-4)}-name`} name="name" type="text" required maxlength="80" value={template.name} />
                        </div>
                        <div class="st-field">
                            <label class="st-label" for={`t-${template.id.slice(-4)}-subject`}>Subject</label>
                            <input class="st-input" id={`t-${template.id.slice(-4)}-subject`} name="subject" type="text" required maxlength="200" value={template.subject} />
                        </div>
                        <div class="st-field">
                            <label class="st-label" for={`t-${template.id.slice(-4)}-body`}>Message</label>
                            <textarea class="st-textarea" id={`t-${template.id.slice(-4)}-body`} name="body" rows="12" required maxlength="8000">{template.body}</textarea>
                        </div>
                        <div class="st-field-row">
                            <div class="st-field">
                                <label class="st-label" for={`t-${template.id.slice(-4)}-order`}>Order in the list</label>
                                <input class="st-input" id={`t-${template.id.slice(-4)}-order`} name="sort_order" type="number" inputmode="numeric" min="0" max="999" value={template.sort_order} />
                            </div>
                            <label class="st-check">
                                <input type="checkbox" name="is_draft" value="1" checked={template.is_draft === 1} />
                                <span>Still a draft</span>
                            </label>
                        </div>
                        <div class="st-actions">
                            <button class="st-button st-button--primary" type="submit">Save</button>
                        </div>
                    </form>
                    <details class="st-details st-details--danger">
                        <summary class="st-details__summary">Delete this template</summary>
                        <form class="st-form" method="post" action={`/api/studio/templates/${template.id}`}>
                            <input type="hidden" name="action" value="delete" />
                            <div class="st-actions">
                                <button class="st-button st-button--danger" type="submit">Delete {template.name}</button>
                            </div>
                        </form>
                    </details>
                </details>
            </div>
        ))}
        <details class="st-details">
            <summary class="st-details__summary">Add a template</summary>
            <form class="st-form" method="post" action="/api/studio/templates">
                <div class="st-field">
                    <label class="st-label" for="new-template-name">Name</label>
                    <input class="st-input" id="new-template-name" name="name" type="text" required maxlength="80" />
                </div>
                <div class="st-field">
                    <label class="st-label" for="new-template-subject">Subject</label>
                    <input class="st-input" id="new-template-subject" name="subject" type="text" required maxlength="200" />
                </div>
                <div class="st-field">
                    <label class="st-label" for="new-template-body">Message</label>
                    <textarea class="st-textarea" id="new-template-body" name="body" rows="10" required maxlength="8000"></textarea>
                </div>
                <div class="st-actions">
                    <button class="st-button st-button--primary" type="submit">Add template</button>
                </div>
            </form>
        </details>
    </section>

    <p class="st-hint">Travel fees may apply for locations outside the local service area. Add a travel fee to a booking when it applies.</p>

    {
        kinds.map(({ kind, title, items, empty }) => {
            const shown = items.filter((item) => item.active);
            const hidden = items.filter((item) => !item.active);
            return (
                <section class="st-section" aria-labelledby={`${kind}-heading`}>
                    <h2 class="st-section-title" id={`${kind}-heading`}>{title}</h2>
                    {shown.length === 0 && <p class="st-quiet">{empty}</p>}
                    {shown.map((item) => (
                        <div class="st-price-item">
                            <details class="st-details">
                                <summary class="st-details__summary">
                                    <span class="st-price-item__head">
                                        <span>{item.name}</span>
                                        <span>{formatCents(item.price_cents)}</span>
                                    </span>
                                </summary>
                                {kind === 'package' && packageDetails(item as never).length > 0 && (
                                    <ul class="st-included">
                                        {packageDetails(item as never).map((line) => <li>{line}</li>)}
                                    </ul>
                                )}
                                <PriceListForm kind={kind} action={`/api/studio/price-list/${kind}/${item.id}`} item={item} submitLabel="Save" idPrefix={`${kind}-${item.id.slice(0, 8)}`} />
                                <form class="st-form" method="post" action={`/api/studio/price-list/${kind}/${item.id}`}>
                                    <input type="hidden" name="action" value="hide" />
                                    <div class="st-actions">
                                        <button class="st-button st-button--quiet" type="submit">Hide {item.name}</button>
                                    </div>
                                </form>
                            </details>
                        </div>
                    ))}

                    {hidden.length > 0 && (
                        <details class="st-details">
                            <summary class="st-details__summary">Hidden ({hidden.length})</summary>
                            {hidden.map((item) => (
                                <form class="st-payment" method="post" action={`/api/studio/price-list/${kind}/${item.id}`}>
                                    <input type="hidden" name="action" value="show" />
                                    <span>
                                        {item.name} <span class="st-optional">({formatCents(item.price_cents)})</span>
                                    </span>
                                    <button class="st-button st-button--quiet" type="submit" aria-label={`Show ${item.name} again`}>
                                        Show again
                                    </button>
                                </form>
                            ))}
                        </details>
                    )}

                    <details class="st-details">
                        <summary class="st-details__summary">{kind === 'package' ? 'Add a package' : 'Add an extra'}</summary>
                        <PriceListForm kind={kind} action={`/api/studio/price-list/${kind}`} submitLabel={kind === 'package' ? 'Add package' : 'Add extra'} idPrefix={`new-${kind}`} />
                    </details>
                </section>
            );
        })
    }

    <section class="st-card" aria-labelledby="account-heading">
        <h2 class="st-card__title" id="account-heading">More</h2>
        <ul class="st-links" role="list">
            <li><a class="st-linkrow-item" href="/studio/deleted">Recently deleted</a></li>
            <li><a class="st-linkrow-item" href="/cdn-cgi/access/logout">Sign out{user ? ` (signed in as ${firstNameFromEmail(user.email)})` : ''}</a></li>
        </ul>
    </section>
</StudioLayout>
