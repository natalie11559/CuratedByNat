# Public build settings. Set these as build variables in Cloudflare (Workers > Settings > Build).
# The Turnstile site key is public. `npm run build` stops with an error without it, so production can
# never ship without spam protection. `npm run dev` falls back to Cloudflare's test key when it is empty.
# Local test build only: PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build
PUBLIC_TURNSTILE_SITE_KEY=
# Keystatic Cloud project, shown in Keystatic Cloud as "team-slug/project-slug".
PUBLIC_KEYSTATIC_CLOUD_PROJECT=
