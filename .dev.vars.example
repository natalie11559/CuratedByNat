# Copy to .dev.vars for local development. Never commit .dev.vars.
# Cloudflare's published Turnstile test secret (always passes). Production uses the real secret,
# stored with: npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional. Without it, local submissions are saved and the email is printed to the terminal
# instead of sent. Production: npx wrangler secret put RESEND_API_KEY
# RESEND_API_KEY=
# Optional. The Instagram feed is off without a token. To try it locally, generate one in Meta's dashboard
# (see "Instagram feed" in README.md). Production: npx wrangler secret put INSTAGRAM_ACCESS_TOKEN
# INSTAGRAM_ACCESS_TOKEN=
# DEPLOY_HOOK_URL=

# Studio (the private CRM) normally sits behind Cloudflare Access. For local development only, these two lines
# skip the sign-in on localhost. They do nothing in a production build or on any other host.
# STUDIO_DEV_EMAIL decides whose name Studio greets you with (hello@curatedbynat.com is Nat).
STUDIO_DEV_BYPASS=1
STUDIO_DEV_EMAIL=hello@curatedbynat.com
