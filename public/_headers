# Security headers for every static response on Cloudflare. No Content-Security-Policy on purpose:
# the Keystatic editor and Cloudflare Turnstile load third-party scripts.
# No Cache-Control here: the Cloudflare adapter adds its own immutable rule for /_astro/* at build time.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# The font files are versioned by hand: rename a file if it ever changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
